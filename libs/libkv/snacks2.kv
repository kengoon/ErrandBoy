<RV>:
    effect_cls: ScrollEffect
    viewclass: "ProductLandscape"
    #data:[{},{},{}]
    RecycleBoxLayout:
        orientation:"vertical"
        default_size_hint: 1, None
        default_size: None, Window.height/4.5
        size_hint_y: None
        height: self.minimum_height
        spacing:dp(10)
        padding: dp(10)
        cols: 1
        key_size: "_size"